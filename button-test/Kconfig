menuconfig KFSW_BUTTON_TEST
	bool "K-FSW button_test example module"
	depends on KFSW_PARAM
	help
	  Enable the button and LED example module: debounced presses, a status
	  API and read-only parameters.

if KFSW_BUTTON_TEST

config KFSW_BUTTON_TEST_GPIO
	bool "Physical GPIO button input"
	depends on GPIO
	help
	  Bind button_test to the GPIO node selected by the composition's
	  kfsw,button-test-button Devicetree chosen property. Leave this disabled
	  for software-only state and PARAM tests.

config KFSW_BUTTON_TEST_LED_GPIO
	bool "Physical GPIO LED outputs"
	depends on GPIO
	help
	  Bind the green, blue, and red hardware-test LEDs to GPIO nodes selected
	  by the composition's kfsw,button-test-led-* Devicetree chosen
	  properties. Each node's GPIO flags define its active polarity.

config KFSW_BUTTON_TEST_DEBOUNCE_MS
	int "Button debounce interval in milliseconds"
	depends on KFSW_BUTTON_TEST_GPIO
	range 1 1000
	default 30
	help
	  Delay from the most recent GPIO edge until the logical button level is
	  sampled. Each new edge restarts this interval.

config KFSW_BUTTON_TEST_SHELL
	bool "button_test hardware-test shell commands"
	depends on SHELL
	default y
	help
	  Add `button_test status` and `test led <green|blue|red> <on|off>`.

endif # KFSW_BUTTON_TEST
