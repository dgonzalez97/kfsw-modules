menuconfig KFSW_TEMPERATURE_SENSOR_EXAMPLE
	bool "K-FSW temperature sensor example module"
	depends on KFSW_PARAM
	help
	  Enable the worked example of a sensor behind a parameter table: a
	  cached temperature reading, the counters that say whether to trust it,
	  and read-only PARAM definitions a housekeeping report can name.

if KFSW_TEMPERATURE_SENSOR_EXAMPLE

config KFSW_TEMP_EXAMPLE_SENSOR
	bool "Read a physical temperature sensor"
	depends on SENSOR
	help
	  Bind the module to the sensor node selected by the composition's
	  kfsw,die-temp Devicetree chosen property and poll it. Leave this
	  disabled to build the cache and its PARAM table with no hardware,
	  which is what the unit tests do.

config KFSW_TEMP_EXAMPLE_PERIOD_MS
	int "Sensor polling interval in milliseconds"
	depends on KFSW_TEMP_EXAMPLE_SENSOR
	range 100 3600000
	default 1000
	help
	  How often the cached reading is refreshed. A housekeeping report reads
	  the cache, so this is the real age of a sample rather than the report
	  period: collecting faster than this repeats a reading.

config KFSW_TEMP_EXAMPLE_MAX_AGE_MS
	int "Maximum cached reading age in milliseconds"
	range 100 7200000
	default 3000
	help
	  Older readings are returned as invalid without accessing the sensor.
	  Set this above the poll interval plus the permitted conversion delay.

config KFSW_TEMP_EXAMPLE_STACK_SIZE
	int "Sensor workqueue stack size"
	depends on KFSW_TEMP_EXAMPLE_SENSOR
	range 1024 8192
	default 1536

config KFSW_TEMP_EXAMPLE_PRIORITY
	int "Sensor workqueue priority"
	depends on KFSW_TEMP_EXAMPLE_SENSOR
	range 2 15
	default 5
	help
	  Use a lower scheduling priority than the CSP router and health work.

config KFSW_TEMP_EXAMPLE_SHELL
	bool "Temperature example shell command"
	depends on SHELL
	default y
	help
	  Add `temp status`, which prints the cached reading and the counters.

endif # KFSW_TEMPERATURE_SENSOR_EXAMPLE
